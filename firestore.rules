rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Inquiries: Anyone can submit a contact request.
    // Read and create are permitted; update and delete are restricted to authenticated accounts.
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }

    // User profiles: Only the authenticated user can access their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
